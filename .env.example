# Copy this file to .env and fill in real values.
# Never commit the actual .env file.

APP_ENV=production

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# PostgreSQL connection string (psycopg3 driver)
DATABASE_URL=postgresql+psycopg://agaram_user:CHANGE_ME@localhost:5432/agaram_finance

# Optional first-admin bootstrap. The account is created only if the
# username does not already exist; restarts never reset its password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
ADMIN_FULL_NAME=Administrator
ADMIN_EMAIL=

BACKUP_FOLDER=/var/lib/agaram_finance/backups
REPORTS_FOLDER=/var/lib/agaram_finance/reports
BACKUP_RETENTION_DAYS=30
MAX_UPLOAD_MB=10